   "source": [
    "Incluye un ejemplo real (clase positiva) para mostrar el formato esperado.\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "return (\n",
    "        \"Clasifica el sentimiento de la siguiente reseña como positivo, \"\n",
    "        \"negativo o neutro. Responde únicamente con una palabra.\\n\\n\"\n",
    "        \"Ejemplo:\\n\"\n",
    "        f\"Reseña: {EJ_POS}\\n\"\n",
    "        \"Sentimiento: positivo\\n\\n\"\n",
    "        f\"Reseña: {resena}\\n\\nSentimiento:\"\n",
    "    )\n",
    "\n",
    "def prompt_few_shot(resena):\n"
