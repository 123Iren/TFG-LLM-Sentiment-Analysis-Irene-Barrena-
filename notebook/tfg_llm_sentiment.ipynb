   "metadata": {},
   "source": [
    "# Cada función recibe una reseña y devuelve el prompt completo que se enviará al modelo.\n",
    "# Todas comparten la misma instrucción base (clasificar como positivo/negativo/neutro,\n",
    "# responder con una sola palabra) para aislar el efecto de cada técnica.\n",
    "\n",
    "CLASES_VALIDAS = {\"positivo\", \"negativo\", \"neutro\"}\n",
    "EJ_POS = ejemplos_por_clase[\"positivo\"]\n",
    "EJ_NEG = ejemplos_por_clase[\"negativo\"]\n",
    "EJ_NEU = ejemplos_por_clase[\"neutro\"]\n",
    "\n",
    "def prompt_zero_shot(resena):\n"
   ],
   "execution_count": null,
