    "with open(\"resultados_parciales_Qwen.json\", \"r\", encoding=\"utf-8\") as f:\n",
    "    datos_qwen = json.load(f)\n",
    "with open(\"resultados_parciales_Mistral.json\", \"r\", encoding=\"utf-8\") as f:\n",
    "    datos_mistral = json.load(f)\n",
