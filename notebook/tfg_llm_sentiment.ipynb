   "source": [
    "### Paso 3: Preparación del dataset de evaluación\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Se descargan 5.000 reseñas del corpus Amazon Reviews Multi (español, split test).\n",
    "# Se mapean las puntuaciones a tres clases: positivo (4-5), negativo (1-2), neutro (3).\n",
    "# Se seleccionan 200 reseñas por muestreo aleatorio con seed=42.\n",
    "# Se reservan 3 reseñas reales (una por clase) como ejemplos para one-shot y few-shot,\n",
    "# excluyéndolas del conjunto de evaluación para evitar fuga de datos.\n",
    "\n",
    "print(\"Cargando Amazon Reviews Multi (español)...\")\n",
    "try:\n",
    "    amazon_ds = load_dataset(\"mteb/amazon_reviews_multi\", \"es\", split=\"test\")\n",
    "except Exception:\n",
    "    amazon_ds = load_dataset(\n",
    "        \"json\",\n",
    "        data_files=\"https://huggingface.co/datasets/mteb/amazon_reviews_multi/resolve/main/es/test.jsonl\",\n",
    "        split=\"train\",\n",
    "    )\n",
    "\n",
    "def mapear_label(label):\n"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Mapea la puntuación original (0-4) a esquema ternario.\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "if label <= 1:\n",
    "        return \"negativo\"\n",
    "    elif label == 2:\n",
    "        return \"neutro\"\n",
    "    else:\n",
    "        return \"positivo\"\n",
    "\n",
    "# Selección de ejemplos reales para one-shot y few-shot\n",
    "ejemplos_por_clase = {\"positivo\": None, \"negativo\": None, \"neutro\": None}\n",
    "indices_ejemplos = set()\n",
    "for i, r in enumerate(amazon_ds):\n",
    "    clase = mapear_label(r[\"label\"])\n",
    "    if ejemplos_por_clase[clase] is None:\n",
    "        ejemplos_por_clase[clase] = r[\"text\"]\n",
    "        indices_ejemplos.add(i)\n",
    "    if all(v is not None for v in ejemplos_por_clase.values()):\n",
    "        break\n",
    "\n",
    "print(\"Ejemplos reales para prompts:\")\n",
    "for clase, texto in ejemplos_por_clase.items():\n",
    "    print(f\"  {clase}: {texto[:80]}...\")\n",
    "\n",
    "# Muestreo de 200 reseñas (excluyendo los ejemplos)\n",
    "np.random.seed(42)\n",
    "indices_disponibles = [i for i in range(len(amazon_ds)) if i not in indices_ejemplos]\n",
    "indices = np.random.choice(indices_disponibles, size=200, replace=False)\n",
    "subset = amazon_ds.select(indices.tolist())\n",
    "\n",
    "textos = [r[\"text\"] for r in subset]\n",
    "labels_true = [mapear_label(r[\"label\"]) for r in subset]\n",
    "\n",
    "print(f\"\\nReseñas para evaluación: {len(textos)}\")\n",
    "from collections import Counter\n",
    "print(f\"Distribución: {Counter(labels_true)}\")\n"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
